# KewaFlow Environment Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL - ADR-003)
# When running locally outside Docker, use localhost:5432
DATABASE_URL=postgresql://kewaflow:kewaflow_dev_password@localhost:5432/kewaflow?schema=public

# Queue & Background Workers (Redis - ADR-004)
# When running locally outside Docker, use localhost:6379
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3 - ADR-005)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kewaflow_minio
S3_SECRET_ACCESS_KEY=kewaflow_minio_password
S3_BUCKET_NAME=kewaflow-media
S3_FORCE_PATH_STYLE=true

# Security (SEC-003)
# 32-byte hexadecimal encryption key for encrypting Meta tokens and API credentials at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=kewaflow_dev_session_secret_change_in_production

# Meta Integration
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# AI Provider Budget Cap (USD)
AI_MONTHLY_BUDGET_CAP_USD=0.00
